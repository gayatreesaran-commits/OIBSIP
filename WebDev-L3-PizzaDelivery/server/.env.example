# Copy to .env and fill in. Only secrets and per-environment values live here;
# tunables (TTLs, limits, thresholds, cron) live in server/config/*.js.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Colourised, readable logs (shows Ethereal preview links clearly). Dev only.
LOG_PRETTY=true

# MongoDB Atlas connection string (mongodb+srv://...). Atlas supports transactions.
MONGODB_URI=
# At least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma separated browser origins allowed by CORS, and the base URL used in email links.
CLIENT_ORIGIN=http://localhost:5173
CLIENT_BASE_URL=http://localhost:5173

# Email: ethereal (fake inbox, needs internet access to api.nodemailer.com)
#        | log (development only: prints each email and its links in the server log,
#               works offline and on networks that block Ethereal; refused in production)
#        | smtp
EMAIL_PROVIDER=ethereal
EMAIL_FROM_ADDRESS=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Payment: mock (local fake checkout) | razorpay (test or live keys)
PAYMENT_PROVIDER=mock
MOCK_PAYMENT_SECRET=change-me-local-only
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Used once by `pnpm create-admin`
ADMIN_EMAIL=
ADMIN_PASSWORD=
